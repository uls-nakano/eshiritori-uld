{
  "name": "eshiritori-uld",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run check:branch && run-p --continue-on-error --aggregate-output check:kit check:rules check:index check:trace check:model-trace format:check && run-p --continue-on-error --aggregate-output lint lint:unused typecheck check:boundaries check:db",
    "check:fast": "run-p --continue-on-error --aggregate-output check:kit check:rules check:index check:trace format:check && run-p --continue-on-error --aggregate-output lint:fast lint:unused typecheck check:boundaries check:db",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json}\" \"!.claude/**\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json}\" \"!.claude/**\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fast": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix",
    "lint:unused": "knip",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts --noEmit",
    "check:boundaries": "depcruise packages apps tests --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check:kit": "node scripts/uld/uld.mjs check-kit",
    "check:rules": "node scripts/uld/uld.mjs check-rules",
    "check:index": "node scripts/uld/uld.mjs check-index",
    "check:branch": "node scripts/uld/uld.mjs check-branch",
    "check:trace": "node scripts/uld/uld.mjs check-trace",
    "check:model-trace": "node scripts/uld/uld.mjs check-model-trace",
    "db:up": "docker compose up -d dynamodb && npm run db:create-tables",
    "db:create-tables": "tsx scripts/create-tables.ts",
    "db:down": "docker compose down",
    "loop:stats": "node scripts/uld/uld.mjs loop-stats",
    "generate:api": "npm run generate -w @eshiritori/api-contract",
    "start:api": "npm run start -w @eshiritori/api",
    "test:integration": "npm run test:integration -w @eshiritori/tests",
    "check:db": "run-s --continue-on-error coverage test:integration"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tests"
  ],
  "prettier": {
    "printWidth": 100
  },
  "knip": {
    "ignore": [
      ".claude/**",
      "scripts/uld/**",
      "packages/api-contract/src/generated/**"
    ],
    "workspaces": {
      "packages/*": {
        "project": [
          "src/**/*.ts"
        ]
      },
      "apps/*": {
        "project": [
          "src/**/*.ts"
        ]
      },
      "tests": {
        "entry": [
          "integration/**/*.integration.test.ts"
        ],
        "project": [
          "**/*.ts"
        ]
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "knip": "^6.40.0",
    "npm-run-all2": "^8.0.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1148.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
