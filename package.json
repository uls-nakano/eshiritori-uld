{
  "name": "eshiritori-uld",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run check:branch && run-p --continue-on-error --aggregate-output check:kit check:rules check:index check:trace check:model-trace format:check && run-p --continue-on-error --aggregate-output lint lint:unused typecheck check:boundaries coverage",
    "check:fast": "run-p --continue-on-error --aggregate-output check:kit check:rules check:index check:trace format:check && run-p --continue-on-error --aggregate-output lint:fast lint:unused typecheck check:boundaries coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json}\" \"!.claude/**\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json}\" \"!.claude/**\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fast": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix",
    "lint:unused": "knip",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:boundaries": "depcruise packages --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check:kit": "node scripts/uld/uld.mjs check-kit",
    "check:rules": "node scripts/uld/uld.mjs check-rules",
    "check:index": "node scripts/uld/uld.mjs check-index",
    "check:branch": "node scripts/uld/uld.mjs check-branch",
    "check:trace": "node scripts/uld/uld.mjs check-trace",
    "check:model-trace": "node scripts/uld/uld.mjs check-model-trace",
    "loop:stats": "node scripts/uld/uld.mjs loop-stats"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "prettier": {
    "printWidth": 100
  },
  "knip": {
    "ignore": [
      ".claude/**",
      "scripts/uld/**"
    ],
    "workspaces": {
      "packages/*": {
        "project": [
          "src/**/*.ts"
        ]
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "knip": "^6.40.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
